# Copy this file to .env. Never commit or show your real key in a recording.
# Gemini supplies the model; the agent uses the OpenAI Agents SDK.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional OpenAI-provider setup is documented in README.md.

# Optional absolute paths; defaults are the bundled catalog and runtime/reading_lists.sqlite3.
# CAMPUS_CATALOG_PATH=/absolute/path/to/catalog.json
# CAMPUS_DB_PATH=/absolute/path/to/reading_lists.sqlite3
